<div id= "login-page">
  <div class="login-card">
    <h1 class="login-title">ログイン</h1>

    <%= form_with url: login_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", required: true %>
      </div>

      <div class="login-actions">
        <%= f.submit "ログイン", class: "btn-primary-main login-button" %>
      </div>
    <% end %>

    <div class="login-actions">
      <div class="login-divider">
        <span>または</span>
      </div>

      <%= form_with url: "/auth/line",
                    method: :post,
                    data: { turbo: false },
                    html: { class: "line-login-form" } do %>
        <button type=submit" class="line-login-button">
          <span class="line-icon">
            <%= image_tag "line_icon.png", alt: "LINE", class: "line-icon-img" %>
          </span>
          <span class="line-text">LINEでログイン</span>
        </button>
      <% end %>

      <%= link_to "← もどる", root_path, class: "btn-text-link login-back" %>
    </div>
  </div>
</div>
