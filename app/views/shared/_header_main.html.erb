<header class="header-main">
  <nav class="nav-container">
    <div class="header-left">
      <button class="hamburger-menu" type="button" id="hamburger-button" aria-label="メニューを開く">
        <i class="fas fa-bars"></i>
      </button>
    </div>

    <div class="header-center">
      <%= link_to root_path, class: "logo-link" do %>
        <div class="logo-wrapper">
          <%= image_tag 'logo.png', alt: 'ことのは', class: 'logo-image' %>
          <span class="app-name">ことのは</span>
        </div>
      <% end %>
    </div>

    <div class="header-right">
      <div class="account-switcher">
        <p class="switcher-label">お子さま切り替え</p>

        <div class="user-info-container">
          <div class="switcher-control">
            <button class="user-icon-button" type="button">
              <i class="fas fa-user-circle switcher-icon"></i>
            </button>
          </div>

          <ul class="dropdown-menu">
            <% current_user.children.decorate.each do |child| %>
              <% if child.persisted? %>
                <li>
                  <%= link_to switch_child_path(child), data: { turbo_method: :post }, class: "dropdown-item" do %>
                    <span class="child-name"><%= child.name %></span>
                    <span class="child-age"><%= child.current_age %></span>
                  <% end %>
                </li>
              <% end %>
            <% end %>
          </ul>

          <p class= "selected-child-name">
            <%= current_child&.name || "お子様が選択されていません" %>
          </p>
        </div>
      </div>
    </div>
  </nav>

  <!-- 背景オーバーレイ -->
  <div id="menu-overlay" class="menu-overlay"></div>

  <!-- サイドメニュー -->
  <aside id="side-menu" class="side-menu">
    <div class="side-menu-header">
      <%= link_to new_child_recording_path(current_child), class: "side-menu-logo" do %>
        <%= image_tag 'logo.png', alt: 'ことのは', class: 'side-menu-logo-image' %>
        <span>ことのは</span>
      <% end %>
    </div>

    <ul class="side-menu-list">
        <li>
          <%= link_to "ホーム", new_child_recording_path(current_child),
            class: "side-menu-link #{'active' if current_page?(new_child_recording_path(current_child))}" %>
        </li>
        <li>
          <%= link_to "ことば一覧", child_recordings_path(current_child),
            class: "side-menu-link #{'active' if current_page?(child_recordings_path(current_child))}" %>
        </li>
        <li>
          <%= link_to "大切なことば", child_favorites_path(current_child),
            class: "side-menu-link #{'active' if current_page?(child_favorites_path(current_child))}" %>
        </li>
        <li>
          <%= link_to "一年前の今日", on_this_day_child_recordings_path(current_child),
            class: "side-menu-link #{'active' if current_page?(on_this_day_child_recordings_path(current_child))}" %>
        </li>
        <li>
          <%= link_to "設定", settings_path,
            class: "side-menu-link #{'active' if current_page?(settings_path)}" %>
        </li>
        <li>
          <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, class: "side-menu-link logout-link" %>
        </li>
    </ul>
  </aside>
</header>
