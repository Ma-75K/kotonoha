<div id="user-edit-page">
  <div class="user-edit-card">
    <h1 class="edit-page-title">お名前変更</h1>

    <%= form_with model: @user, url: update_name_user_path, method: :patch, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "お名前", class: "form-label" %>
        <%= f.text_field :name, class: "form-field" %>

        <% if @user.errors[:name].any? %>
          <p class="error-message">
            <%= @user.errors.full_messages_for(:name).first %>
          </p>
        <% end %>
      </div>

      <div class="form-actions">
        <%= f.submit "保存", class: "save-btn" %>
        <%= link_to "キャンセル", settings_path, class: "back-btn" %>
      </div>
    <% end %>
  </div>
</div>
