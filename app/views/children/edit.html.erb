<div id="child-edit-page">
  <div class="child-edit-card">
    <h1 class="edit-page-title">お子さま情報変更</h1>

    <%= form_with model: @child, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, "お名前", class: "form-label" %>
        <%= f.text_field :name, class: "form-field" %>

        <% if @child.errors[:name].any? %>
          <p class="error-message">
            <%= @child.errors.full_messages_for(:name).first %>
          </p>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :birthday, "生年月日", class: "form-label" %>
        <%= f.date_field :birthday, class: "form-field date-field" %>

        <% if @child.errors[:birthday].any? %>
          <p class="error-message">
            <%= @child.errors.full_messages_for(:birthday).first %>
          </p>
        <% end %>
      </div>

      <div class="form-actions form-actions-row">
        <%= f.button "変更", type: "submit", class: "action-btn edit-save-btn" %>

        <%= link_to "削除",
          child_path(@child),
          data: { turbo_method: :delete, turbo_confirm: "削除します。よろしいですか？" },
          class: "action-btn delete-btn" %>
      </div>
    <% end %>

    <div class="form-actions form-actions-single">
      <%= link_to "← 設定画面にもどる", settings_path, class: "btn-text-link" %>
    </div>
  </div>
</div>
