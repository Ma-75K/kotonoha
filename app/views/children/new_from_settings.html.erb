<div id="child-new-page">
  <div class="child-new-card">
    <h1 class="edit-page-title">お子さまを追加</h1>

    <%= form_with model: @child, url: create_from_settings_children_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, class: "form-field" %>

        <% if @child.errors[:name].any? %>
          <div class="errors-message">
            <%= @child.errors.full_messages_for(:name).join(", ") %>
          </div>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :birthday, class: "form-label" %>
        <%= f.date_field :birthday, class: "form-field date-field" %>

        <% if @child.errors[:birthday].any? %>
          <div class="errors-message">
            <%= @child.errors.full_messages_for(:birthday).join(", ") %>
          </div>
        <% end %>
      </div>

      <div class="form-actions-single">
        <%= f.button "追加", type: "submit", class: "action-btn save-btn" %>
      </div>
    <% end %>

    <div class="form-actions-single cancel-area">
      <%= link_to "キャンセル", settings_path, class: "action-btn cancel-btn" %>
    </div>
  </div>
</div>
