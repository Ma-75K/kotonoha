<div id="on-this-day-page">
  <div class="on-this-day-card">
    <h1 class="page-title">一年前の今日</h1>

    <p class="target-date-main">
      <%= @target_date.strftime('%Y/%m/%d') %>
    </p>

    <p class="target-date-sub">
      -----  あの日のことば  -----
    </p>

    <% if @recordings.any? %>
      <div class="recordings-list">
        <% @recordings.each do |recording| %>
          <%= link_to child_recording_path(@child, recording), class: "recording-item" do %>
            <div class="recording-item-left">
              <p class="recording-title"><%= recording.title %></p>
              <p class="recording-duration">
                <%= format_duration(recording.duration) %>
              </p>
            </div>

            <div class="recording-item-right">
              <p class="recording-date"><%= recording.recorded_at.strftime('%Y/%m/%d') %></p>
              <p class="recording-age"><%= @child.age_at(recording.recorded_at) %>のころ</p>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="pagination-area">
        <%= paginate @recordings %>
      </div>

    <% else %>
      <p class="empty-message">この日のことばは、まだありません</p>
    <% end %>

    <div class="back-home-area">
      <%= link_to "[ もどる ]", new_child_recording_path(@child.id), class: "home-btn" %>
    </div>
  </div>
</div>
