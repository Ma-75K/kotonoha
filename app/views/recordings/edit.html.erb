<div id="recording-edit-page">
  <div class="recording-edit-card">

    <%= form_with model: [@child, @recording], local: true do |f| %>
      <div class ="form-area">
        <div class="form-group">
          <%= f.label :title, "タイトル", class: "form-label" %>
          <%= f.text_field :title, class: "form-field form-input" %>

          <% if @recording.errors[:title].any? %>
            <p class="errors-message">
              <%= @recording.errors.full_messages_for(:title).join(", ") %>
            </p>
          <% end %>
        </div>

        <div class="form-group">
          <%= f.label :comment, "ひとこと", class: "form-label" %>
          <%= f.text_area :comment, class: "form-field form-textarea" %>

          <% if @recording.errors[:comment].any? %>
            <p class="errors-message">
              <%= @recording.errors.full_messages_for(:comment).join(", ") %>
            </p>
          <% end %>
        </div>
      </div>

      <div class="btn-area">
        <%= f.submit "保存", class: "save-btn" %>
        <%= link_to "キャンセル", child_recording_path(@child, @recording), class: "back-btn" %>
      </div>
    <% end %>
  </div>
</div>
