<!-- 間違ってshow（詳細画面）の自分で実装したHTMLになっている -->
<div class="container">
  <div class="preview-info">
    <p class="childname"><%= @child.name %></p>

    <div class="form-group">
      <label>タイトル</label>
      <p class="preview-value">無題</p>
    </div>

    <div class="form-group">
      <label>ひとこと</label>
      <div class="preview-empty-box">
        (まだ入力されていません)
      </div>
    </div>
  </div>

  <div class="button-group">
    <%= link_to "編集する", edit_recording_path, class: "btn btn-primary" %>
  </div>

  <div class="field">
    <%= @recording.created_at.strftime("%Y/%m/%d") %>
  </div>

  <div id="audio-preview">
    <audio id="audio-player" controls></audio>
    <p class="duration">
    録音時間: <span id="preview-duration">00:00</span>
    </p>
  </div>

  <div class="button-group">
    <button id="play-btn">再生</button>
    <button id="delete-btn">削除</button>
  </div>

  <div class="back">
    <%= link_to "[ 一覧に戻る ]", records_path %>
  </div>
</div>
