<div id="recording-page">
  <div id="success-messages"></div>
  <div id="error-messages"></div>

  <!-- 録音開始初期画面 -->
  <div id="initial-screen">
    <div class="child-name">
      <%= @child.name %>
    </div>

    <div class="record-button-wrap">
      <button id="start-recording" class="record-start-button" type="button">
        <span class="record-start-button-outer">
          <span class="record-start-button-inner">
            <i class="fa-solid fa-microphone"></i>
          </span>
        </span>
      </button>

      <p class="record-start-label">ことばをのこす</p>

      <% unless @child.recordings.exists? %>
        <div class="record-guide">
          <i class="fa-regular fa-lightbulb"></i>

          <p>
            今しか聞けないことばを、<br>
            残してみませんか？
          </p>
        </div>
      <% end %>
    </div>

    <div class="recent-recordings-section">
      <h2 class="recent-recordings-title">最近のことば</h2>

      <% if @recent_recordings.any? %>
        <ul class="recent-recordings-list">
          <% @recent_recordings.each do |recording| %>
            <li>
              <%= link_to child_recording_path(@child, recording), class: "recent-recording-item" do %>
                <div class="recent-recording-left">
                  <i class="fa-regular fa-file-audio recent-recording-icon"></i>
                  <span class="recen-recording-name"><%= recording.title.presence || "無題" %></span>
                </div>
                <span class="recent-recording-duration">
                  <%= format_duration(recording.duration) %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="recent-recordings-empty">まだことばの記録がありません。</p>
      <% end %>
    </div>
  </div>

  <!-- 録音中画面 -->
  <div id="recording-screen" style="display:none;">
    <h2 class="recording-status-text">ことばをのこしています</h2>

    <div class="record-button-wrap">
      <button id="stop-recording" class="record-stop-button" type="button" disabled>
        <span class="record-stop-button-outer">
          <span class="record-stop-button-inner">
            <i class="fa-solid fa-stop"></i>
          </span>
        </span>
      </button>
    </div>

    <div class="recording-time">
      <span id="recording-duration">00:00</span>
    </div>

    <p class="record-start-label">タップして停止</p>
  </div>

  <!-- プレビュー画面 -->
  <div id="preview-area" style="display: none;">
    <h2>無題</h2>

    <!-- 録音時間（数字だけ） -->
    <div class="duration">
      <span id="preview-duration">00:00</span>
    </div>

    <!-- 再生バー -->
    <input type="range" id="seek-bar" value="0">

    <!-- 経過時間 -->
    <div class="current-time">
      <span id="current-time">00:00</span>
    </div>

    <!-- 音声 -->
    <audio id="audio-player"></audio>

    <!-- 初期UI（再生前）⇒ 再生中UI -->
    <div class="audio-controls">
      <button id="play-toggle-button" type="button">
        <i id="play-icon" class="fa-solid fa-play"></i>
      </button>
    </div>

  <!-- 保存フォーム -->
  <%= form_with model: @recording,
                url: child_recordings_path(@child),
                id: "save-recording-form",
                local: false do |f| %>

    <%= f.hidden_field :title, value: "無題", id: 'title-field' %>
    <%= f.hidden_field :duration, id: "duration-field" %>

    <div class="form-actions preview-actions">
      <%= f.submit "保存", class: "btn-primary-main preview-save-button", id: "save-button" %>
      <button type="button" class="btn-text-link preview-back-link" id="back-to-initial">
        ← もどる
      </button>
    </div>
  <% end %>
</div>
