<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kotonoha" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <meta name="description" content="子どもの声と言葉をワンタップで記録。今しか残せない瞬間を、未来の宝物に。">

    <mata property="og:title" content="ことのは">
    <meta property="og:description" content="子どもの声と言葉をワンタップで記録。今しか残せない瞬間を、未来の宝物に。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= image_url('ogp.png') %>">

    <meta name="twitter:card" content="summary_large_image">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Application CSS（Tailwind CSS + カスタムCSS） -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- JavaScript（Importmap） -->
    <%= javascript_importmap_tags %>

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.20/index.global.min.js"></script>
  </head>

  <body>
    <!--  ヘッダーの条件分岐 -->
    <% if logged_in? %>
      <%= render 'shared/header_main' %>
    <% else %>
      <%= render 'shared/header_simple' %>
    <% end %>

    <!-- フラッシュメッセージは全ページで共通表示 -->
    <% if flash[:success] || flash[:alert] %>
      <div class="container mt-3">
        <% if flash[:success] %>
          <div class="alert alert-success alert-dismissible fade show auto-close-flash" role="alert">
            <%= flash[:success] %>

            <button
              type="button"
              class="btn-close"
              aria-label="Close"
              onclick="this.parentElement.remove()">
            </button>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flash[:alert] %>
            <button type="button" class="btn-close" aria-label="Close" onclick="this.parentElement.remove()"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <!-- フッター -->
    <%= render 'shared/footer' %>
  </body>
</html>
