<div id="settings-page">
  <div class="settings-card">
    <h1 class="settings-title">アカウント設定</h1>

    <div class="settings-section">
      <div class="setting-item">
        <p class="setting-label">お名前</p>
        <%= link_to edit_name_user_path, class: "setting-box" do %>
          <span><%= @user.name %></span>
          <span class="arrow">&gt;</span>
        <% end %>
      </div>

      <div class="setting-item">
        <p class="setting-label">メールアドレス</p>

        <% if @user.provider == "line" && @user.email.start_with?("line_") %>
          <div class="setting-box">
            <span>LINEログインで登録済み</span>
          </div>
        <% else %>
          <%= link_to edit_email_user_path, class: "setting-box" do %>
            <span><%= @user.email %></span>
            <span class="arrow">&gt;</span>
          <% end %>
        <% end %>
      </div>

      <div class="setting-item">
        <%= link_to new_password_reset_path, class: "setting-box setting-link" do %>
          <span>パスワードリセット</span>
          <span class="arrow">&gt;</span>
        <% end %>
      </div>
    </div>

    <h2 class="settings-subtitle">お子さま情報設定</h2>

    <div class="children-settings-list">
      <% @children.each_with_index do |child, index| %>
        <div class="setting-item">
          <p class="setting-label"><%= index + 1 %>人目</p>

          <%= link_to edit_child_path(child), class: "setting-box child-setting-box" do %>
            <!-- 左側 -->
            <div class="child-info">
              <p class="child-setting-name"><%= child.name %></p>
              <p class="child-setting-birthday"><%= child.birthday.strftime("%Y/%m/%d") %></p>
            </div>

            <!-- 右側 -->
            <div class="arrow-wrapper">
              <span class="arrow">&gt;</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="add-child-area">
        <%= link_to "[ + お子さまを追加 ]", new_from_settings_children_path, class: "add-child-btn" %>
      </div>
    </div>

    <div class="settings-actions">
      <% if session[:from_line_login] %>
        <%= link_to "ホームへ", new_child_recording_path(current_child), class: "setting-back-link" %>
      <% else %>
        <%= link_to "← ホームにもどる", new_child_recording_path(current_child), class: "setting-back-link" %>
      <% end %>

      <%= button_to "ログアウト", logout_path, method: :delete, class: "setting-logout-btn" %>
    </div>
  </div>
</div>
